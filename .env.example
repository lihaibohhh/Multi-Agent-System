# Copy this file to .env and fill in local secrets.
DEEPSEEK_MODEL=deepseek/deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
TAVILY_API_KEY=

# Read-only retrieval through the sibling knowledge-service.
KNOWLEDGE_SERVICE_BASE_URL=http://127.0.0.1:8001
KNOWLEDGE_SERVICE_API_KEY=
KNOWLEDGE_SERVICE_TIMEOUT=60
KNOWLEDGE_SERVICE_TOP_K=3
KNOWLEDGE_SERVICE_RETRIEVAL_MODE=hybrid

# LangGraph checkpoint persistence. Each research run maps to one thread_id.
CHECKPOINT_BACKEND=postgres
POSTGRES_DB_URL=postgresql://multi_agent_user:change-me@127.0.0.1:5432/multi_agent
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Stage 1: serial chapters, bounded retrieval and draft revision.
AGENT_SECTION_MODEL=deepseek/deepseek-chat
AGENT_SECTION_MAX_COUNT=4
AGENT_SECTION_MAX_SEARCH_ROUNDS=2
AGENT_SECTION_MAX_REVISIONS=1
